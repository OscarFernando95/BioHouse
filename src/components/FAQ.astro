---
interface Pregunta {
  pregunta: string;
  respuesta: string;
}

interface Props {
  titulo?: string;
  preguntas: Pregunta[];
}

const { titulo = "Preguntas frecuentes", preguntas } = Astro.props;

const datosFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: preguntas.map((p) => ({
    "@type": "Question",
    name: p.pregunta,
    acceptedAnswer: { "@type": "Answer", text: p.respuesta },
  })),
};
---

<section class="py-20 sm:py-24">
  <div class="container-ancho max-w-3xl">
    <h2 class="text-center font-heading text-4xl font-bold sm:text-5xl" data-reveal>{titulo}</h2>
    <div class="mt-12 space-y-6">
      {
        preguntas.map((p, indice) => (
          <div
            class="rounded-xl border border-black/5 bg-mint/40 p-6"
            data-reveal={indice % 2 === 0 ? "izquierda" : "derecha"}
            style={`--reveal-delay: ${indice * 100}ms`}
          >
            <h3 class="font-heading text-lg font-semibold text-ink">{p.pregunta}</h3>
            <p class="mt-2 text-sm leading-relaxed">{p.respuesta}</p>
          </div>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(datosFaq)} is:inline />
</section>
