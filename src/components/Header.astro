---
import { navegacion, enlaceWhatsapp } from "../data/site.js";

const rutaActual = Astro.url.pathname.replace(/\/$/, "") || "/";

function estaActivo(href: string) {
  return href === "/" ? rutaActual === "/" : rutaActual.startsWith(href);
}
---

<header
  data-encabezado
  class="sticky top-0 z-50 border-b border-black/5 bg-white/90 backdrop-blur transition-shadow duration-300"
>
  <div class="container-ancho flex h-20 items-center justify-between gap-6">
    <a href="/" class="logo-enlace flex items-center gap-3">
      <img
        src="/images/logo-bio.png"
        alt="Bio House Constructora"
        class="logo-vivo h-11 w-auto sm:h-12"
        width="400"
        height="400"
      />
      <span class="font-heading text-lg font-extrabold leading-none tracking-tight text-ink sm:text-xl">
        BIO HOUSE
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navegación principal">
      {
        navegacion.map((item) => (
          <div class="group relative">
            <a
              href={item.href}
              class:list={[
                "font-heading text-[0.95rem] font-semibold transition-colors hover:text-primary",
                estaActivo(item.href) ? "text-primary" : "text-ink",
              ]}
            >
              {item.etiqueta}
            </a>
            {item.hijos && (
              <div class="invisible absolute left-1/2 top-full z-10 w-56 -translate-x-1/2 translate-y-1 rounded-lg border border-black/5 bg-white p-2 opacity-0 shadow-xl shadow-black/5 transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                {item.hijos.map((hijo) => (
                  <a
                    href={hijo.href}
                    class="block rounded-md px-3 py-2 text-sm font-medium text-body transition-colors hover:bg-mint hover:text-primary-dark"
                  >
                    {hijo.etiqueta}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href={enlaceWhatsapp()} target="_blank" rel="noopener noreferrer" class="boton-primario hidden sm:inline-flex">
        Hablemos por WhatsApp
      </a>
      <button
        id="boton-menu-movil"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-black/10 text-ink lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="menu-movil" class="hidden border-t border-black/5 bg-white lg:hidden">
    <nav class="container-ancho flex flex-col gap-1 py-4" aria-label="Navegación móvil">
      {
        navegacion.map((item) => (
          <div>
            <a href={item.href} class="block rounded-md px-2 py-2.5 font-heading font-semibold text-ink hover:bg-mint">
              {item.etiqueta}
            </a>
            {item.hijos && (
              <div class="ml-3 flex flex-col border-l border-black/10 pl-3">
                {item.hijos.map((hijo) => (
                  <a href={hijo.href} class="rounded-md px-2 py-2 text-sm text-body hover:bg-mint hover:text-primary-dark">
                    {hijo.etiqueta}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
      <a href={enlaceWhatsapp()} target="_blank" rel="noopener noreferrer" class="boton-primario mt-3 justify-center">
        Hablemos por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const boton = document.getElementById("boton-menu-movil");
  const menu = document.getElementById("menu-movil");

  boton?.addEventListener("click", () => {
    const abierto = menu?.classList.toggle("hidden") === false;
    boton.setAttribute("aria-expanded", String(abierto));
  });
</script>
