---
import Layout from "../layouts/Layout.astro";
import HeroInterior from "../components/HeroInterior.astro";
import IconoRedSocial from "../components/IconoRedSocial.astro";
import Icono from "../components/Icono.astro";
import { sitio, redesSociales, enlaceWhatsapp } from "../data/site.js";
---

<Layout titulo="Contacto | Bio House Constructora Pitalito, Huila" descripcion="Hablemos de tu proyecto sostenible. Escríbenos, llámanos o agenda una conversación con nuestro equipo.">
  <HeroInterior
    imagen="/images/240_F_445467139_pTBW8OrcgV7GDwIeuOnMjmMLJRFMdZiv.jpg"
    alt="Hablemos de tu proyecto con Bio House Constructora"
    frase="Hablemos de tu proyecto sostenible"
    titulo="Cuéntanos tu idea y te ayudamos a hacerla realidad"
    botones={[{ texto: "Escríbenos por WhatsApp", href: enlaceWhatsapp("Hola Bio House, quiero recibir asesoría sobre mi proyecto."), externo: true }]}
  />

  <section class="py-20 sm:py-24">
    <div class="container-ancho grid gap-16 lg:grid-cols-2">
      <div data-reveal="izquierda">
        <h2 class="font-heading text-2xl font-semibold sm:text-3xl">Cuéntanos sobre tu proyecto</h2>
        <p class="mt-4 leading-relaxed">
          Estamos listos para escucharte y ayudarte a evaluar una solución constructiva sostenible, eficiente y
          viable.
        </p>

        <dl class="mt-8 space-y-4 text-sm">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary">
              <Icono nombre="ubicacion" class="h-4 w-4" />
            </span>
            <dt class="font-heading font-semibold text-ink">Ubicación</dt>
            <dd>{sitio.ciudad}</dd>
          </div>
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary">
              <Icono nombre="telefono" class="h-4 w-4" />
            </span>
            <dt class="font-heading font-semibold text-ink">Teléfono</dt>
            <dd><a href={`tel:${sitio.telefono.replace(/\s/g, "")}`} class="hover:text-primary">{sitio.telefono}</a></dd>
          </div>
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary">
              <Icono nombre="correo" class="h-4 w-4" />
            </span>
            <dt class="font-heading font-semibold text-ink">Correo</dt>
            <dd><a href={`mailto:${sitio.email}`} class="hover:text-primary">{sitio.email}</a></dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-wrap gap-3">
          {
            redesSociales.map((red) => (
              <a
                href={red.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-11 w-11 items-center justify-center rounded-full border border-black/10 text-ink transition-colors hover:border-primary hover:text-primary"
                aria-label={red.nombre}
              >
                <IconoRedSocial nombre={red.nombre} class="h-4.5 w-4.5" />
              </a>
            ))
          }
        </div>

        <a href={enlaceWhatsapp("Hola Bio House, quiero recibir asesoría sobre mi proyecto.")} target="_blank" rel="noopener noreferrer" class="boton-primario mt-10">
          Escríbenos por WhatsApp
        </a>
      </div>

      <div class="rounded-xl border border-black/5 bg-white p-8 shadow-sm shadow-black/5" data-reveal="derecha" style="--reveal-delay: 100ms">
        <h2 class="font-heading text-xl font-semibold">Agendar un café</h2>
        <p class="mt-2 text-sm">Completa el formulario y te contactaremos por WhatsApp.</p>
        <form id="formulario-contacto" class="mt-6 space-y-5">
          <div>
            <label for="nombre" class="mb-1.5 block text-sm font-semibold text-ink">Nombre completo*</label>
            <input id="nombre" name="nombre" type="text" required class="w-full rounded-md border border-black/15 px-4 py-3 text-sm outline-none focus:border-primary" />
          </div>
          <div>
            <label for="correo" class="mb-1.5 block text-sm font-semibold text-ink">Correo electrónico*</label>
            <input id="correo" name="correo" type="email" required class="w-full rounded-md border border-black/15 px-4 py-3 text-sm outline-none focus:border-primary" />
          </div>
          <div>
            <label for="telefono" class="mb-1.5 block text-sm font-semibold text-ink">Teléfono / WhatsApp*</label>
            <input id="telefono" name="telefono" type="tel" required class="w-full rounded-md border border-black/15 px-4 py-3 text-sm outline-none focus:border-primary" />
          </div>
          <div>
            <label for="mensaje" class="mb-1.5 block text-sm font-semibold text-ink">Mensaje*</label>
            <textarea id="mensaje" name="mensaje" rows="4" required class="w-full rounded-md border border-black/15 px-4 py-3 text-sm outline-none focus:border-primary"></textarea>
          </div>
          <button type="submit" class="boton-primario w-full">Enviar mensaje</button>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-ink py-20 text-white sm:py-24">
    <div class="container-ancho flex flex-col items-center gap-6 text-center" data-reveal="abajo">
      <h2 class="max-w-2xl font-heading text-4xl font-bold text-white sm:text-5xl">Construyamos con propósito</h2>
      <p class="max-w-xl text-white/75">
        Agenda una conversación con nuestro equipo y descubre cómo transformar tu proyecto en una solución
        constructiva sostenible, eficiente y con impacto real.
      </p>
    </div>
  </section>
</Layout>

<script>
  const formulario = document.getElementById("formulario-contacto") as HTMLFormElement | null;
  const numeroWhatsapp = "573146231387";

  formulario?.addEventListener("submit", (evento) => {
    evento.preventDefault();
    const datos = new FormData(formulario);
    const nombre = datos.get("nombre");
    const correo = datos.get("correo");
    const telefono = datos.get("telefono");
    const mensaje = datos.get("mensaje");

    const texto = `Hola Bio House, mi nombre es ${nombre}.\nCorreo: ${correo}\nTeléfono: ${telefono}\nMensaje: ${mensaje}`;
    window.open(`https://wa.me/${numeroWhatsapp}?text=${encodeURIComponent(texto)}`, "_blank", "noopener,noreferrer");
    formulario.reset();
  });
</script>
