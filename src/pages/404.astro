---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Página no encontrada" descripcion="La página que buscas no existe.">
  <section class="flex min-h-[60vh] flex-col items-center justify-center gap-6 py-24 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="font-heading text-4xl font-extrabold sm:text-5xl">No encontramos esta página</h1>
    <p class="max-w-md">Puede que el enlace esté roto o la página haya sido movida.</p>
    <a href="/" class="boton-primario">Volver al inicio</a>
  </section>
</Layout>
