---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CtaFinal from "../components/CtaFinal.astro";
import Icono from "../components/Icono.astro";
import FAQ from "../components/FAQ.astro";
import imagenHero from "../assets/images/full_domotica.webp";
import imagenControl from "../assets/images/revista-s360-domotica.webp";
import imagenServicio from "../assets/images/full_domotica_2.webp";
import imagenInteligente from "../assets/images/full_domotica_4.webp";

const beneficios = [
  {
    icono: "chip" as const,
    titulo: "Control centralizado",
    texto: "Gestiona iluminación, climatización, seguridad y accesos desde un solo sistema, en tiempo real y desde cualquier lugar.",
  },
  {
    icono: "rayo" as const,
    titulo: "Ahorro energético",
    texto: "La automatización de luces y climatización reduce el consumo eléctrico al ajustar el uso a la ocupación real del espacio.",
  },
  {
    icono: "escudo" as const,
    titulo: "Mayor seguridad",
    texto: "Sensores, cámaras y alertas integradas fortalecen la seguridad de viviendas y proyectos comerciales.",
  },
  {
    icono: "engranaje" as const,
    titulo: "Integración desde el diseño",
    texto: "Coordinamos la domótica con arquitectura e ingeniería desde el inicio del proyecto, evitando retrabajos e instalaciones improvisadas.",
  },
];

const preguntas = [
  {
    pregunta: "¿Qué diferencia a la domótica de un sistema de automatización tradicional?",
    respuesta:
      "La domótica integra todos los sistemas del hogar o proyecto (iluminación, climatización, seguridad y sensores) en una sola plataforma inteligente, mientras que la automatización tradicional suele resolver un solo aspecto de forma aislada.",
  },
  {
    pregunta: "¿La domótica se puede instalar en proyectos ya construidos?",
    respuesta:
      "Sí. Aunque la integración es más eficiente cuando se planea desde el diseño arquitectónico, también implementamos soluciones de domótica adaptadas a viviendas y edificaciones existentes.",
  },
  {
    pregunta: "¿Qué tipo de proyectos pueden beneficiarse de la domótica inteligente?",
    respuesta:
      "Viviendas unifamiliares, proyectos multifamiliares, oficinas y espacios comerciales que buscan mayor eficiencia energética, seguridad y confort a través de la automatización.",
  },
];
---

<Layout
  titulo="Domótica Inteligente para tu Hogar"
  descripcion="Domótica inteligente para espacios más eficientes y seguros: automatización con control total y tranquilidad."
>
  <!-- Héroe -->
  <section class="relative flex min-h-[70vh] items-center overflow-hidden bg-deep" data-parallax-contenedor>
    <Image
      src={imagenHero}
      alt="Domótica inteligente Bio House"
      format="webp"
      quality={78}
      class="absolute inset-0 h-full w-full scale-110 object-cover"
      data-parallax
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-deep via-deep/70 to-deep/20"></div>
    <div class="container-ancho relative py-20 text-white texto-contraste" data-entrada>
      <p class="eyebrow text-mint-deep">Domótica inteligente</p>
      <h1 class="mt-4 max-w-2xl font-heading text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">
        Domótica inteligente para espacios más eficientes y seguros
      </h1>
      <a href="/contacto" class="boton-primario mt-8">Agenda una asesoría en domótica</a>
    </div>
  </section>

  <!-- Control total -->
  <section class="py-20 sm:py-24">
    <div class="container-ancho grid gap-14 lg:grid-cols-2 lg:items-center">
      <div data-reveal="izquierda">
        <h2 class="font-heading text-4xl font-bold sm:text-5xl">
          Automatizamos tu proyecto para que tengas control total, eficiencia y tranquilidad.
        </h2>
        <p class="mt-5 leading-relaxed">
          Integramos sensores, iluminación, seguridad y climatización en un solo sistema inteligente, pensado para
          hogares y proyectos que buscan eficiencia real.
        </p>
        <a href="/contacto" class="boton-oscuro mt-8">Habla con un especialista</a>
      </div>
      <div class="overflow-hidden rounded-xl" data-reveal="derecha" style="--reveal-delay: 100ms">
        <Image src={imagenControl} alt="Control total con domótica" width={900} format="webp" loading="lazy" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- En qué consiste -->
  <section class="bg-mint py-20 sm:py-24">
    <div class="container-ancho grid gap-14 lg:grid-cols-2 lg:items-center">
      <div class="order-2 overflow-hidden rounded-xl lg:order-1" data-reveal="izquierda">
        <Image src={imagenServicio} alt="Servicio de domótica" format="webp" loading="lazy" class="h-full w-full object-cover" />
      </div>
      <div class="order-1 lg:order-2" data-reveal="derecha" style="--reveal-delay: 100ms">
        <h2 class="font-heading text-4xl font-bold sm:text-5xl">¿En qué consiste nuestro servicio de Domótica?</h2>
        <p class="mt-4 leading-relaxed">
          Diseñamos e instalamos sistemas de automatización adaptados al tipo de proyecto, integrados desde la etapa
          de diseño arquitectónico para un funcionamiento óptimo.
        </p>
        <a href="/contacto" class="boton-primario mt-8">Conoce cómo funciona</a>
      </div>
    </div>
  </section>

  <!-- Domótica inteligente -->
  <section class="py-20 sm:py-24">
    <div class="container-ancho grid gap-14 lg:grid-cols-2 lg:items-center">
      <div data-reveal="izquierda">
        <h2 class="font-heading text-4xl font-bold sm:text-5xl">Domótica inteligente</h2>
        <p class="mt-5 leading-relaxed">
          Tecnología inteligente que mejora la forma de habitar los espacios. Haz que tu proyecto sea más eficiente,
          seguro y preparado para el futuro.
        </p>
        <a href="/contacto" class="boton-oscuro mt-8">Inicia tu proyecto inteligente</a>
      </div>
      <div class="overflow-hidden rounded-xl" data-reveal="derecha" style="--reveal-delay: 100ms">
        <Image src={imagenInteligente} alt="Domótica inteligente para el hogar" format="webp" loading="lazy" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="bg-mint py-20 sm:py-24">
    <div class="container-ancho">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <h2 class="font-heading text-4xl font-bold sm:text-5xl">Beneficios de automatizar tu proyecto</h2>
      </div>
      <div class="mt-14 grid gap-8 md:grid-cols-2">
        {
          beneficios.map((beneficio, indice) => (
            <div
              class="rounded-xl bg-white p-7 shadow-sm shadow-black/5"
              data-reveal={indice % 2 === 0 ? "izquierda" : "derecha"}
              style={`--reveal-delay: ${indice * 100}ms`}
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
                <Icono nombre={beneficio.icono} class="h-6 w-6" />
              </span>
              <h3 class="mt-4 font-heading text-lg font-semibold text-primary-dark">{beneficio.titulo}</h3>
              <p class="mt-3 text-sm leading-relaxed">{beneficio.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FAQ titulo="Preguntas frecuentes sobre domótica" preguntas={preguntas} />

  <CtaFinal
    titulo="Lleva la domótica a tu próximo proyecto"
    texto="Cuéntanos qué necesitas automatizar y diseñamos una solución a la medida."
    textoBoton="Agenda una asesoría"
  />
</Layout>
