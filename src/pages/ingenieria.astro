---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CtaFinal from "../components/CtaFinal.astro";
import Icono from "../components/Icono.astro";
import FAQ from "../components/FAQ.astro";
import imagenHero from "../assets/images/IMG-20210228-WA0015.jpg";
import imagenServicio from "../assets/images/IMG_20210415_150426760-scaled.jpg";
import imagenEnfoque from "../assets/images/240_F_445467139_pTBW8OrcgV7GDwIeuOnMjmMLJRFMdZiv.jpg";
import imagenSoluciones from "../assets/images/IMG_20210415_150321463-scaled.jpg";

const preguntas = [
  {
    pregunta: "¿Qué incluye el servicio de ingeniería de Bio House Constructora?",
    respuesta:
      "Estudios técnicos, diseño estructural, cálculo de cargas, coordinación con arquitectura y sistemas sostenibles, y supervisión de obra alineados con la normativa vigente en Colombia.",
  },
  {
    pregunta: "¿La ingeniería se integra con el sistema constructivo de plástico recuperado?",
    respuesta:
      "Sí. Nuestros ingenieros diseñan cada estructura considerando las propiedades específicas de los bloques de plástico recuperado, garantizando estabilidad, resistencia y cumplimiento normativo.",
  },
  {
    pregunta: "¿Trabajan con estudios de suelo y viabilidad técnica previos a la construcción?",
    respuesta:
      "Sí, realizamos el diagnóstico técnico inicial necesario para definir la viabilidad estructural del proyecto antes de avanzar al diseño y la etapa de obra.",
  },
];

const etapas = [
  {
    icono: "objetivo" as const,
    titulo: "Diagnóstico técnico",
    texto: "Evaluamos el terreno, las cargas previstas y las condiciones del entorno para definir la viabilidad estructural del proyecto.",
  },
  {
    icono: "engranaje" as const,
    titulo: "Diseño estructural",
    texto: "Calculamos y dimensionamos la estructura considerando el sistema constructivo de bloques de plástico recuperado.",
  },
  {
    icono: "escudo" as const,
    titulo: "Cumplimiento normativo",
    texto: "Verificamos que cada diseño cumpla la normativa sismo-resistente y de construcción vigente en Colombia.",
  },
  {
    icono: "calendario" as const,
    titulo: "Supervisión de obra",
    texto: "Acompañamos la ejecución en campo para asegurar que lo construido corresponda exactamente al diseño técnico aprobado.",
  },
];
---

<Layout
  titulo="Ingeniería Constructiva"
  descripcion="Ingeniería aplicada para construir con seguridad y eficiencia: viabilidad técnica, seguridad estructural y cumplimiento normativo."
>
  <!-- Héroe -->
  <section class="py-20 sm:py-24">
    <div class="container-ancho grid gap-14 lg:grid-cols-2 lg:items-center">
      <div data-entrada>
        <p class="eyebrow">Ingeniería aplicada</p>
        <h1 class="mt-4 font-heading text-4xl font-extrabold leading-tight sm:text-5xl">
          Ingeniería aplicada para construir con seguridad y eficiencia
        </h1>
        <p class="mt-6 leading-relaxed">
          Desarrollamos soluciones de ingeniería que garantizan viabilidad técnica, seguridad estructural y
          cumplimiento normativo en cada proyecto.
        </p>
        <a href="/contacto" class="boton-primario mt-8">Agenda una asesoría técnica</a>
      </div>
      <div class="overflow-hidden rounded-xl" data-entrada style="--entrada-delay: 150ms">
        <Image src={imagenHero} alt="Ingeniería aplicada Bio House" format="webp" loading="lazy" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- En qué consiste -->
  <section class="bg-mint py-20 sm:py-24">
    <div class="container-ancho grid gap-14 lg:grid-cols-2 lg:items-center">
      <div class="order-2 overflow-hidden rounded-xl lg:order-1" data-reveal="izquierda">
        <Image src={imagenServicio} alt="Servicio de ingeniería" width={900} format="webp" loading="lazy" class="h-full w-full object-cover" />
      </div>
      <div class="order-1 lg:order-2" data-reveal="derecha" style="--reveal-delay: 100ms">
        <h2 class="font-heading text-4xl font-bold sm:text-5xl">¿En qué consiste nuestro servicio de Ingeniería?</h2>
        <p class="mt-4 leading-relaxed">
          Acompañamos cada proyecto con estudios técnicos, diseño estructural y supervisión en obra, integrando
          nuestro sistema constructivo con los estándares de la ingeniería tradicional.
        </p>
        <a href="/contacto" class="boton-oscuro mt-8">Hablemos de tu proyecto</a>
      </div>
    </div>
  </section>

  <!-- Enfoque -->
  <section class="py-20 sm:py-24">
    <div class="container-ancho grid gap-14 lg:grid-cols-2 lg:items-center">
      <div data-reveal="izquierda">
        <h2 class="font-heading text-4xl font-bold sm:text-5xl">Nuestro enfoque en ingeniería</h2>
        <p class="mt-4 leading-relaxed">
          Combinamos rigor técnico y eficiencia constructiva para asegurar que cada estructura sea segura, duradera y
          viable económicamente.
        </p>
        <a href="/contacto" class="boton-primario mt-8">Consulta con un ingeniero</a>
      </div>
      <div class="overflow-hidden rounded-xl" data-reveal="derecha" style="--reveal-delay: 100ms">
        <Image src={imagenEnfoque} alt="Enfoque en ingeniería" format="webp" loading="lazy" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Soluciones -->
  <section class="bg-ink py-20 text-white sm:py-24">
    <div class="container-ancho grid gap-14 lg:grid-cols-2 lg:items-center">
      <div class="order-2 overflow-hidden rounded-xl lg:order-1" data-reveal="izquierda">
        <Image src={imagenSoluciones} alt="Soluciones de ingeniería" width={900} format="webp" loading="lazy" class="h-full w-full object-cover" />
      </div>
      <div class="order-1 lg:order-2" data-reveal="derecha" style="--reveal-delay: 100ms">
        <h2 class="font-heading text-4xl font-bold text-white sm:text-5xl">¿Qué tipo de soluciones ofrecemos?</h2>
        <p class="mt-4 leading-relaxed text-white/80">
          Estudios técnicos, diseño estructural, coordinación con arquitectura y sistemas sostenibles, y supervisión
          de obra alineados con la normativa vigente.
        </p>
        <a href="/contacto" class="boton-primario mt-8">¿Tu proyecto requiere ingeniería especializada?</a>
      </div>
    </div>
  </section>

  <!-- Etapas -->
  <section class="py-20 sm:py-24">
    <div class="container-ancho">
      <h2 class="text-center font-heading text-4xl font-bold sm:text-5xl" data-reveal>
        Etapas de nuestro proceso de ingeniería
      </h2>
      <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {
          etapas.map((etapa, indice) => (
            <div
              class="rounded-xl border border-black/5 p-7"
              data-reveal={["izquierda", "abajo", "abajo", "derecha"][indice]}
              style={`--reveal-delay: ${indice * 100}ms`}
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
                <Icono nombre={etapa.icono} class="h-6 w-6" />
              </span>
              <h3 class="mt-4 font-heading text-lg font-semibold text-primary-dark">{etapa.titulo}</h3>
              <p class="mt-3 text-sm leading-relaxed">{etapa.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FAQ titulo="Preguntas frecuentes sobre ingeniería" preguntas={preguntas} />

  <CtaFinal
    titulo="Ingeniería que respalda cada decisión constructiva"
    texto="Trabajamos para que cada proyecto se construya sobre bases técnicas sólidas, eficientes y responsables."
    textoBoton="Inicia tu proyecto con nosotros"
  />
</Layout>
