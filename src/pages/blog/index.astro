---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import HeroInterior from "../../components/HeroInterior.astro";
import { getCollection } from "astro:content";
import { formatearFecha } from "../../utils/fechas";

const entradas = (await getCollection("blog", ({ data }) => data.publicado)).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);
---

<Layout titulo="Blog de Construcción Sostenible" descripcion="Artículos de Bio House Constructora sobre construcción sostenible, economía circular y vivienda del futuro.">
  <HeroInterior
    imagen="/images/240_F_436392941_nTkBmmHSocMfO2TopRGhMfDfUJIsVIc9.jpg"
    alt="Blog de Bio House Constructora"
    frase="Ideas para construir un futuro sostenible"
    titulo="Artículos sobre construcción sostenible y economía circular"
    texto="Historias, ideas y aprendizajes de Bio House Constructora sobre la vivienda del futuro."
  />

  <section class="py-20 sm:py-24">
    <div class="container-ancho grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        entradas.map((entrada, indice) => (
          <a
            href={`/blog/${entrada.id}`}
            class="group flex flex-col overflow-hidden rounded-xl border border-black/5 shadow-sm shadow-black/5 transition-shadow hover:shadow-lg"
            data-reveal={["izquierda", "abajo", "derecha"][indice % 3]}
            style={`--reveal-delay: ${indice * 120}ms`}
          >
            <div class="aspect-[16/10] overflow-hidden">
              <Image
                src={entrada.data.imagen}
                alt={entrada.data.textoAlternativo}
                format="webp"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <h2 class="font-heading text-lg font-semibold group-hover:text-primary-dark">{entrada.data.titulo}</h2>
              <time datetime={entrada.data.fecha.toISOString().slice(0, 10)} class="mt-1 block text-xs text-ink/50">{formatearFecha(entrada.data.fecha)}</time>
              <p class="mt-2 text-sm leading-relaxed">{entrada.data.resumen}</p>
              <span class="mt-4 inline-block text-sm font-semibold uppercase tracking-wide text-primary">
                Leer más »
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
